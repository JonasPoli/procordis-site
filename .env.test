# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Os testes usam SQLite (schema recriado a partir do mapeamento Doctrine a cada teste),
# então não precisam de um MySQL. Para usar outro banco, sobrescreva em .env.test.local.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
