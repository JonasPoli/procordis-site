{% extends 'base_public.html.twig' %}

{% block title %}Especialidades - Procordis{% endblock %}
{% block meta_description %}Conheça as especialidades cardiológicas e exames diagnósticos oferecidos pela Associação Procordis em Araraquara.{% endblock %}

{% block content %}
	{# Hero Standardized #}
	<div class="bg-[#2993C9] dark:bg-[#031219] text-primary-foreground py-20 text-center relative overflow-hidden">
		<div class="absolute inset-0 z-0 bg-cover bg-center opacity-20" style="background-image: url('{{ asset('images/background02.png')|imagine_filter('page_header') }}'); filter: grayscale(100%);"></div>
		<div class="container mx-auto px-6 relative z-10 text-center">
			{# Breadcrumb #}
			<nav class="flex justify-center items-center gap-2 text-sm text-primary-foreground/80 mb-6" aria-label="Breadcrumb">
				<a href="{{ path('app_home') }}" class="hover:text-white transition-colors">Início</a>
				<span class="opacity-50">/</span>
				<span class="font-medium text-white">Especialidades</span>
			</nav>

			<h1 class="font-heading text-4xl md:text-5xl font-bold mb-4" data-aos="fade-up">Nossas Especialidades</h1>
			<p class="text-xl opacity-90 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="100">
				Exames e procedimentos diagnósticos para cuidar da sua saúde cardiovascular com tecnologia de ponta.
			</p>
		</div>
	</div>

	{# Specialty Grid Section #}
	<section class="py-16 md:py-24 bg-background">
		<div class="container mx-auto px-4">
			{% if specialties|length > 0 %}
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{% for specialty in specialties %}
						<div class="group bg-card rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-border flex flex-col h-full" data-aos="fade-up" data-aos-delay="{{ loop.index * 50 }}">
							<div class="w-16 h-16 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
								{% if specialty.svgIcon %}
									<div class="w-8 h-8">
										{{ specialty.svgIcon|raw }}
									</div>
								{% else %}
									<i data-lucide="activity" class="w-8 h-8"></i>
								{% endif %}
							</div>

							<h3 class="text-2xl font-bold text-foreground mb-4 group-hover:text-primary transition-colors">
								{{ specialty.name }}
							</h3>

							<p class="text-muted-foreground mb-6 flex-grow line-clamp-3">
								{{ specialty.shortDescription|default(specialty.fullText|default('')|striptags)|raw }}
							</p>

							<a href="{{ path('app_specialty_show', {slug: specialty.slug}) }}" class="inline-flex items-center text-primary font-semibold group-hover:gap-2 transition-all mt-auto">
								Saiba mais
								<span class="sr-only">sobre {{ specialty.name }}</span>
								<i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>
							</a>
						</div>
					{% endfor %}
				</div>
			{% else %}
				<div class="text-center py-16 bg-card rounded-2xl border border-border">
					<p class="text-muted-foreground">Em breve mais especialidades serão adicionadas.</p>
				</div>
			{% endif %}
		</div>
	</section>

	{# Referral Notice #}
	<section class="py-16 bg-amber-500 text-white">
		<div class="container mx-auto px-4 text-center">
			<h2 class="text-3xl md:text-4xl font-bold mb-6">Atendimento por Encaminhamento</h2>
			<p class="text-xl opacity-90 mb-8 max-w-2xl mx-auto">Nosso ambulatório atende exclusivamente pacientes encaminhados pelo sistema de saúde ou médico assistente.</p>
			<a href="{{ path('app_about') }}" class="inline-flex items-center px-8 py-4 bg-white text-amber-600 font-bold rounded-xl hover:bg-slate-100 transition-colors">
				<i data-lucide="info" class="w-5 h-5 mr-2"></i>
				Conheça Nosso Ambulatório
			</a>
		</div>
	</section>
{% endblock %}
