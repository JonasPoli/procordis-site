{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
    {{ form_row(form.email) }}

    <fieldset class="mb-6">
        <legend class="block mb-2 text-sm font-semibold text-slate-600 dark:text-slate-300">{{ form.accessType.vars.label }}</legend>
        {{ form_errors(form.accessType) }}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {% for choice in form.accessType %}
                {% set is_admin_choice = choice.vars.value == constant('App\\Entity\\User::ROLE_ADMIN') %}
                <label class="flex items-start gap-3 p-4 rounded-xl border border-slate-200 dark:border-slate-600 bg-white/60 dark:bg-slate-800/40 cursor-pointer hover:border-blue-400 transition-colors has-[:checked]:border-blue-500 has-[:checked]:ring-2 has-[:checked]:ring-blue-500/20 {{ form.accessType.vars.disabled ? 'opacity-70 cursor-not-allowed' : '' }}">
                    {{ form_widget(choice, {'attr': {'class': 'mt-1 text-blue-600 focus:ring-blue-500'}}) }}
                    <span>
                        <span class="block font-semibold text-slate-800 dark:text-slate-100">{{ choice.vars.label }}</span>
                        <span class="block text-xs text-slate-500 dark:text-slate-400 mt-1">
                            {{ is_admin_choice ? 'Acesso total a todas as áreas do painel, inclusive usuários.' : 'Apenas notícias, categorias de notícias e galeria (imagens e vídeos).' }}
                        </span>
                    </span>
                </label>
            {% endfor %}
        </div>
        {% if form.accessType.vars.disabled %}
            <p class="mt-2 text-xs text-amber-600 dark:text-amber-400">{{ form.accessType.vars.help }}</p>
        {% endif %}
    </fieldset>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {% for field in [form.plainPassword.first, form.plainPassword.second] %}
            <div class="mb-6">
                {{ form_label(field) }}
                {{ form_errors(field) }}
                {{ form_widget(field) }}
                {% if field.vars.help %}
                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{{ field.vars.help }}</p>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    {{ form_errors(form.plainPassword) }}

    <div class="flex justify-end pt-6">
        <button class="bg-blue-600 text-white px-6 py-3 rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-500/30 transition-all font-semibold">{{ button_label|default('Salvar') }}</button>
    </div>
{{ form_end(form) }}
