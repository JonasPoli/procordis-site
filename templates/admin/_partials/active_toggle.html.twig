{# Alternância rápida de "Ativo" via AJAX (controller Stimulus active-toggle).
   Parâmetros: url (rota POST de alternância), active (bool), name (texto para leitores de tela). #}
<button type="button"
        role="switch"
        aria-checked="{{ active ? 'true' : 'false' }}"
        aria-label="{{ name|default('Item') }}: {{ active ? 'ativo' : 'inativo' }}. Clique para alternar."
        title="Clique para {{ active ? 'desativar' : 'ativar' }}"
        class="group inline-flex items-center gap-2 rounded-full p-1 focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-500/30 aria-busy:opacity-60 aria-busy:cursor-wait"
        data-controller="active-toggle"
        data-action="active-toggle#toggle"
        data-active-toggle-url-value="{{ url }}"
        data-active-toggle-token-value="{{ csrf_token('admin_ajax') }}"
        data-active-toggle-active-value="{{ active ? 'true' : 'false' }}"
        data-active-toggle-name-value="{{ name|default('Item') }}">
    <span class="relative inline-flex h-6 w-11 shrink-0 rounded-full bg-slate-300 dark:bg-slate-600 transition-colors group-aria-checked:bg-emerald-500" aria-hidden="true">
        <span class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform group-aria-checked:translate-x-5"></span>
    </span>
    <span data-active-toggle-target="label" class="text-xs font-semibold text-slate-500 dark:text-slate-400 group-aria-checked:text-emerald-700 dark:group-aria-checked:text-emerald-300">{{ active ? 'Ativo' : 'Inativo' }}</span>
</button>
