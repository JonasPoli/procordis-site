{% extends 'admin/base_admin.html.twig' %}

{% block page_title %}Parceiros{% endblock %}

{% block body %}
    <div class="mb-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold">Parceiros</h1>
        <a href="{{ path('admin_partner_new') }}" class="btn bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700 transition">
            + Novo Parceiro
        </a>
    </div>

    <div class="glass-panel overflow-hidden rounded-xl">
        <table class="w-full text-left border-collapse">
            <thead class="bg-gray-50/50 dark:bg-slate-800/50 border-b border-gray-100 dark:border-white/10">
                <tr>
                    <th class="p-4 font-semibold text-gray-600 dark:text-gray-400">Logo (Thumb)</th>
                    <th class="p-4 font-semibold text-gray-600 dark:text-gray-400">Nome / Título</th>
                    <th class="p-4 font-semibold text-gray-600 dark:text-gray-400">Link</th>
                    <th class="p-4 font-semibold text-gray-600 dark:text-gray-400">Ordem</th>
                    <th class="p-4 font-semibold text-gray-600 dark:text-gray-400">Ativo</th>
                    <th class="p-4 font-semibold text-gray-600 dark:text-gray-400 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="text-gray-600 dark:text-gray-300 text-sm font-light">
                {% for partner in partners %}
                <tr class="border-b border-gray-100/50 dark:border-white/5 hover:bg-white/40 dark:hover:bg-white/5 transition-colors">
                    <td class="p-4">
                        {% if partner.imageName %}
                            <img src="{{ vich_uploader_asset(partner, 'imageFile')|imagine_filter('partner_thumb') }}" class="h-12 w-auto max-w-[120px] object-contain rounded bg-white p-1 border" alt="{{ partner.title }}">
                        {% else %}
                            <span class="text-gray-400 italic">Sem logo</span>
                        {% endif %}
                    </td>
                    <td class="p-4 text-sm font-medium text-gray-900 dark:text-white">{{ partner.title }}</td>
                    <td class="p-4 text-sm">
                        {% if partner.link %}
                            <a href="{{ partner.link }}" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">
                                {{ partner.link }}
                            </a>
                        {% else %}
                            <span class="text-gray-400 italic">Sem link</span>
                        {% endif %}
                    </td>
                    <td class="p-4 text-sm">{{ partner.sortOrder }}</td>
                    <td class="p-4">
                        {% if partner.active %}
                            <span class="px-2 py-1 text-xs font-bold text-green-700 bg-green-100 rounded-full">Sim</span>
                        {% else %}
                            <span class="px-2 py-1 text-xs font-bold text-red-700 bg-red-100 rounded-full">Não</span>
                        {% endif %}
                    </td>
                    <td class="p-4 text-right">
                        {{ include('admin/_partials/action_buttons.html.twig', {
                            edit_url: path('admin_partner_edit', {id: partner.id}),
                            delete_url: path('admin_partner_delete', {id: partner.id}),
                            csrf_token: csrf_token('delete' ~ partner.id)
                        }) }}
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" class="p-8 text-center text-gray-500 dark:text-gray-400">Nenhum parceiro cadastrado.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
