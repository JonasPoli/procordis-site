{% extends 'admin/base_admin.html.twig' %}

{% block page_title %}Editar Notícia{% endblock %}

{% block body %}
    <div class="glass-panel p-6 rounded-2xl">
        <div class="mb-4">
            <a href="{{ path('admin_news_index') }}" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 transition-colors">&larr; Voltar para lista</a>
        </div>
        
        {{ include('admin/news/_form.html.twig', {'button_label': 'Atualizar'}) }}
    </div>

    {{ include('admin/news_gallery/_manager.html.twig', {
        news: news,
        items: galleryItems,
        max_upload_bytes: galleryMaxUploadBytes,
        max_upload_label: galleryMaxUploadLabel
    }) }}
{% endblock %}
